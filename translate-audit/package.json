{
  "name": "translate-audit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "translate-audit": "src/cli.ts"
  },
  "scripts": {
    "audit": "node --experimental-strip-types --no-warnings src/cli.ts",
    "review": "node --experimental-strip-types --no-warnings src/cli.ts review",
    "review:dev": "concurrently -k -n server,vite -c cyan,magenta \"npm run review -- --port 8788\" \"vite\"",
    "build:web": "vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings src server web/src test",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "mongodb": "6.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "oxlint": "1.19.0",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "4.1.11"
  }
}
